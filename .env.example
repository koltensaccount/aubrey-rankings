# Database Configuration
DATABASE_URL="postgresql://koltenbendickson@localhost:5432/aubrey_rankings"

# Better Auth
BETTER_AUTH_SECRET="replace-with-a-random-32-byte-hex-or-base64-secret"
BETTER_AUTH_URL="http://localhost:3000"

# TMDB API (Server-side only)
# Get your API Read Access Token or API Key from https://www.themoviedb.org/settings/api
TMDB_API_READ_ACCESS_TOKEN=""
TMDB_API_KEY=""

# Resend Transactional Email (Production / Email Verification)
RESEND_API_KEY=""
EMAIL_FROM="Aubrey Rankings <accounts@aubrey.koltensserver.com>"

# Optional Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Production Host
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Bug-report administration: empty lists deny all. Prefer stable user IDs.
ADMIN_USER_IDS=""
ADMIN_EMAILS=""

# Dedicated internal release scheduler credential; never reuse BETTER_AUTH_SECRET.
CRON_SECRET=""
